# Copy this file to .env and fill in your values. Never commit .env to Git.

# --- LLM ---
# "anthropic" uses the real model. "fake" is a scripted offline backup (no API key needed).
LLM_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_AGENT_STEPS=8
MAX_VISITOR_MESSAGES=30

# --- Admin view (/admin) ---
# Leave empty on your own laptop. Set a long random value if the app is ever reachable by others.
ADMIN_TOKEN=
