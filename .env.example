# Copy this file to .env and fill in your values. Never commit .env to Git.

# --- LLM ---
# "anthropic" uses the real model. "fake" is a scripted offline backup (no API key needed).
LLM_MODE=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_AGENT_STEPS=8
MAX_VISITOR_MESSAGES=30

# --- Admin view (/admin) ---
# Required for the public link: without it, /admin only works from this laptop.
# Use a long random value and type it into the box at the top of /admin.
ADMIN_TOKEN=

# --- Limits for a public link (each question costs API credits) ---
RATE_LIMIT_PER_MINUTE=6
MAX_DAILY_MESSAGES=150
